# AI 제공자: gemini(무료 등급, 기본값) 또는 claude(유료)
LLM_PROVIDER=gemini

# Gemini API 키 (aistudio.google.com → Get API key, 무료)
# 무료 등급은 하루 호출 수 제한이 있고, 입력 내용이 Google 제품 개선에 쓰일 수 있습니다
GEMINI_API_KEY=

# Claude API 키 (LLM_PROVIDER=claude일 때만, 유료)
ANTHROPIC_API_KEY=

# 모델명 (비우면 gemini-3.8-flash / claude-opus-5-5)
LLM_MODEL=

# GitHub 토큰 (선택). 없으면 시간당 60회, 있으면 5000회까지 호출 가능
GITHUB_TOKEN=

# ---- 배포할 때만 (로컬에서는 비워 두면 꺼짐) ----
# 이 코드를 아는 사람만 분석·결과 보기 가능
ACCESS_CODE=
# 하루 분석 횟수 상한 (0 = 제한 없음). Gemini 무료 한도를 지키기 위해
DAILY_ANALYSIS_LIMIT=0
PER_IP_DAILY_LIMIT=0
# 캐시·결과 저장 위치 (디스크가 유지되는 볼륨이 있으면 그 경로로)
# CACHE_DIR=/data
